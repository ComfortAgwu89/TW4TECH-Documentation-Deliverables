# Copy this file to .env and replace the example API key before starting TW4.
# cp .env.example .env

# Host interface the HTTP server binds to. Use 0.0.0.0 inside Docker.
HOST=0.0.0.0

# TCP port the API listens on.
PORT=3000

# Secret required in the X-API-Key header for POST, PATCH, PUT, and DELETE.
API_KEY=change-me-now

# JSON file used as the task store.
DATA_FILE=./data/tasks.json

# Log verbosity: error | warn | info | debug
LOG_LEVEL=info

# Node environment: development | production
NODE_ENV=development
